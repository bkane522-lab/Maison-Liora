# Copier ce fichier en `.env` en local (Vercel CLI) et renseigner les
# mêmes variables dans Vercel > Project Settings > Environment Variables.
# NE JAMAIS committer le fichier `.env` réel.

# Disponible dans Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Clé secrète — Supabase > Project Settings > API > service_role
# UNIQUEMENT utilisée côté serveur (api/*.js), jamais exposée au navigateur.
SUPABASE_SERVICE_KEY=
